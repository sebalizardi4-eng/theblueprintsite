---
interface Props {
  whatsappUrl: string;
}
const { whatsappUrl } = Astro.props;
---

<section id="about" class="section about-section">
  <div class="about-bg" aria-hidden="true">
    <img src="/tuanarch87-restaurant-6479814_1920.jpg" alt="" loading="lazy" class="about-bg-img" />
    <div class="about-bg-overlay"></div>
  </div>
  <div class="container about-layout">
    <div class="about-photo-col">
      <div class="about-photo-frame">
        <img
          src="/fabianoadvertising-drink-3502704_1920.jpg"
          alt="Professional bartender preparing craft cocktails"
          loading="lazy"
          class="about-photo"
        />
        <div class="about-photo-corners">
          <span></span><span></span><span></span><span></span>
        </div>
        <div class="about-creds-overlay">
          <div class="cred-item">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span data-i18n="about.cred1">WSET Level 2 Spirits</span>
          </div>
          <div class="cred-item">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span data-i18n="about.cred2">Bar Lead &amp; Consultant</span>
          </div>
          <div class="cred-item">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span data-i18n="about.cred3">Revenue-Focused Approach</span>
          </div>
        </div>
      </div>
    </div>

    <div class="about-content">
      <p class="eyebrow" data-i18n="about.eyebrow">About</p>
      <h2 class="section-title" data-i18n-html="about.title">
        The Bartender<br />Behind the <span class="gold-text">Blueprint</span>
      </h2>
      <p class="about-text" data-i18n="about.p1">
        I'm a bartender, mixologist, and bar consultant based in Puerto Rico with over six years of experience behind the bar across restaurants, events, and hospitality operations.
      </p>
      <p class="about-text" data-i18n="about.p2">
        What sets me apart isn't just time behind the stick — it's what I've built with it. I hold the WSET Level 2 Award in Spirits with Distinction, and I've developed pricing structures, operational manuals, reference guides, and bar programs that actually get used.
      </p>
      <p class="about-text" data-i18n="about.p3">
        I started The Bar Blueprint because I kept seeing the same problems in bar operations — inconsistent standards, outdated pricing, undertrained staff, and owners who didn't know where their money was going. I built a system to fix all of it. Today I work with bar owners and restaurant operators across Puerto Rico to build bars that run better, sell more, and leave every guest wanting to come back.
      </p>
      <div class="about-highlights">
        <div class="highlight">
          <div class="hl-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="8" r="7"></circle>
              <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
            </svg>
          </div>
          <div>
            <strong data-i18n="about.h1t">WSET Level 2 Spirits — Distinction</strong>
            <span data-i18n="about.h1s">Formally certified in spirits education &amp; mixology</span>
          </div>
        </div>
        <div class="highlight">
          <div class="hl-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"></path>
            </svg>
          </div>
          <div>
            <strong data-i18n="about.h2t">Bar Lead &amp; Consultant</strong>
            <span data-i18n="about.h2s">6+ years of hands-on bar operations experience</span>
          </div>
        </div>
        <div class="highlight">
          <div class="hl-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="1" x2="12" y2="23"></line>
              <path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"></path>
            </svg>
          </div>
          <div>
            <strong data-i18n="about.h3t">Revenue-Focused Approach</strong>
            <span data-i18n="about.h3s">Every recommendation tied to measurable results</span>
          </div>
        </div>
      </div>
      <a href={whatsappUrl} id="aboutCtaLink" target="_blank" rel="noopener noreferrer" class="btn btn-gold">
        <span data-i18n="about.cta">Let's Talk About Your Bar</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>
