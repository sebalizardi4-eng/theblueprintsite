---
import Layout from "../layouts/Layout.astro";

const whatsappNumber = "17875253789"; // replace with real number
const whatsappUrlEN = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent("Hello! I'd like to request a free consultation with The Bar Blueprint.")}`;
const whatsappUrlES = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent("¡Hola! Me gustaría solicitar una consulta gratuita con The Bar Blueprint.")}`;
---

<Layout>
  <!-- NAVBAR -->
  <nav id="navbar">
    <div class="nav-inner">
      <a href="#hero" class="nav-logo" aria-label="The Bar Blueprint Home">
        <img src="/logo.png" alt="The Bar Blueprint" height="44" />
      </a>
      <button
        class="nav-toggle"
        id="navToggle"
        aria-label="Open navigation"
        aria-expanded="false"
      >
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="3" y1="6" x2="21" y2="6"></line><line
            x1="3"
            y1="12"
            x2="21"
            y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
      <ul class="nav-links" id="navLinks" role="list">
        <li>
          <a href="#services" class="nav-link" data-i18n="nav.services"
            >Services</a
          >
        </li>
        <li>
          <a href="#gallery" class="nav-link" data-i18n="nav.portfolio"
            >Portfolio</a
          >
        </li>
        <li>
          <a href="#about" class="nav-link" data-i18n="nav.about">About</a>
        </li>
        <li>
          <a href="#process" class="nav-link" data-i18n="nav.process">Process</a
          >
        </li>
      </ul>
      <button class="lang-toggle" id="langToggle" aria-label="Switch language">
        <span id="langEN" class="lang-opt lang-active">EN</span>
        <span class="lang-sep">|</span>
        <span id="langES" class="lang-opt">ES</span>
      </button>
      <a
        href={whatsappUrlEN}
        id="navCtaLink"
        target="_blank"
        rel="noopener noreferrer"
        class="nav-cta"
      >
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          ><path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
          ></path></svg
        >
        <span data-i18n="nav.cta">Free Consultation</span>
      </a>
    </div>
  </nav>

  <!-- HERO -->
  <section id="hero" class="hero">
    <div class="hero-bg" aria-hidden="true">
      <img
        src="/stocksnap-restaurant-2618315_1920.jpg"
        alt=""
        class="hero-bg-img"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero-bg-overlay"></div>
    </div>
    <div class="hero-grid-overlay blueprint-grid" aria-hidden="true"></div>
    <span class="crosshair crosshair-tl" aria-hidden="true"></span>
    <span class="crosshair crosshair-tr" aria-hidden="true"></span>
    <span class="crosshair crosshair-bl" aria-hidden="true"></span>
    <span class="crosshair crosshair-br" aria-hidden="true"></span>

    <div class="hero-inner">
      <div class="hero-content">
        <p class="eyebrow" data-i18n="hero.eyebrow">
          Puerto Rico · Bar Consulting
        </p>
        <h1 class="hero-title">
          <span data-i18n="hero.title1">Elevate Your Bar.</span><br />
          <em class="gold-italic" data-i18n="hero.title2"
            >Maximize Your Revenue.</em
          >
        </h1>
        <p class="hero-subtitle" data-i18n="hero.subtitle">
          Certified Bartender &amp; Mixologist with luxury hospitality
          experience. I engineer menus, train staff, and streamline operations —
          so your bar becomes your most profitable asset.
        </p>
        <div class="hero-ctas">
          <a
            href={whatsappUrlEN}
            id="heroCta1"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-wa btn-lg"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              ><path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
              ></path></svg
            >
            <span data-i18n="hero.cta1">Get Your Free Blueprint</span>
          </a>
          <a href="#services" class="btn btn-ghost btn-lg">
            <span data-i18n="hero.cta2">View Services</span>
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><line x1="5" y1="12" x2="19" y2="12"></line><polyline
                points="12 5 19 12 12 19"></polyline></svg
            >
          </a>
        </div>
        <div class="hero-badges">
          <span class="badge" data-i18n="hero.badge1">Certified Mixologist</span
          >
          <span class="badge" data-i18n="hero.badge2">Bar Lead</span>
          <span class="badge" data-i18n="hero.badge3">6+ Years Experience</span>
        </div>
      </div>

      <div class="hero-photo-panel">
        <div class="photo-frame">
          <img
            src="/fabianoadvertising-drink-3502704_1920.jpg"
            alt="Craft cocktails prepared by a professional bartender"
            loading="eager"
            class="hero-photo"
          />
          <div class="photo-frame-corners">
            <span></span><span></span><span></span><span></span>
          </div>
          <div class="photo-caption" data-i18n="hero.photoCaption">
            Bar Consulting / Pricing · Menus · Operations
          </div>
        </div>
      </div>
    </div>

    <div class="scroll-hint" aria-hidden="true">
      <svg width="1" height="60" viewBox="0 0 1 60"
        ><line
          x1="0.5"
          y1="0"
          x2="0.5"
          y2="60"
          stroke="rgba(201,164,82,0.4)"
          stroke-width="1"></line></svg
      >
    </div>
  </section>

  <!-- CREDENTIALS STRIP -->
  <div class="proof-strip" role="complementary">
    <div class="proof-inner">
      <div class="proof-item">
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><circle cx="12" cy="8" r="7"></circle><polyline
            points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg
        >
        <span data-i18n="proof.certified">Certified Mixologist</span>
      </div>
      <span class="proof-dot" aria-hidden="true"></span>
      <div class="proof-item">
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"></path><circle
            cx="12"
            cy="10"
            r="3"></circle></svg
        >
        Puerto Rico
      </div>
      <span class="proof-dot" aria-hidden="true"></span>
      <div class="proof-item">
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><rect x="3" y="3" width="18" height="18" rx="2"></rect><path
            d="M3 9h18M9 21V9"></path></svg
        >
        <span data-i18n="proof.wset">WSET Level 2 Spirits</span>
      </div>
      <span class="proof-dot" aria-hidden="true"></span>
      <div class="proof-item">
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path
            d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"
          ></path><rect x="9" y="3" width="6" height="4" rx="1"></rect></svg
        >
        <span data-i18n="proof.kpi">KPI Management Certification</span>
      </div>
      <span class="proof-dot" aria-hidden="true"></span>
      <div class="proof-item">
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"></path><circle
            cx="9"
            cy="7"
            r="4"></circle><path
            d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"></path></svg
        >
        <span data-i18n="proof.barlead">Bar Lead</span>
      </div>
      <span class="proof-dot" aria-hidden="true"></span>
      <div class="proof-item">
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><circle cx="12" cy="8" r="7"></circle><polyline
            points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline></svg
        >
        <span data-i18n="proof.years">6+ Years Experience</span>
      </div>
    </div>
  </div>

  <!-- SERVICES -->
  <section id="services" class="section">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow" data-i18n="svc.eyebrow">What I Offer</p>
        <h2 class="section-title" data-i18n-html="svc.title">
          The Blueprint for<br /><span class="gold-text">Bar Excellence</span>
        </h2>
        <p class="section-desc" data-i18n="svc.desc">
          Every struggling bar has the same core problems. I've solved them
          before — and I'll solve them for you.
        </p>
      </div>
      <div class="services-grid">
        <article class="svc-card">
          <div class="svc-num">01</div>
          <div class="svc-icon" aria-hidden="true">
            <svg
              width="26"
              height="26"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"
              ></path><rect x="9" y="3" width="6" height="4" rx="1"></rect><line
                x1="9"
                y1="12"
                x2="15"
                y2="12"></line><line x1="9" y1="16" x2="12" y2="16"></line></svg
            >
          </div>
          <h3 class="svc-title" data-i18n="svc1.title">
            Cocktail &amp; Menu Development
          </h3>
          <p class="svc-desc" data-i18n="svc1.desc">
            Redesign your menu around profitability. Identify high-margin items,
            eliminate underperformers, and craft cocktail lists that guests love
            and owners profit from.
          </p>
          <ul class="svc-list">
            <li data-i18n="svc1.b1">
              Menu cost analysis &amp; pricing strategy
            </li>
            <li data-i18n="svc1.b2">Signature cocktail development</li>
            <li data-i18n="svc1.b3">Seasonal &amp; trend-driven offerings</li>
          </ul>
        </article>

        <article class="svc-card svc-card--featured">
          <div class="svc-num">02</div>
          <div class="svc-icon" aria-hidden="true">
            <svg
              width="26"
              height="26"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><line x1="12" y1="1" x2="12" y2="23"></line><path
                d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"></path></svg
            >
          </div>
          <h3 class="svc-title" data-i18n="svc2.title">Revenue Optimization</h3>
          <p class="svc-desc" data-i18n="svc2.desc">
            Turn your bar into a revenue engine. Through strategic upselling,
            faster service cycles, and waste reduction, I deliver measurable
            improvements to your bar's performance and profitability.
          </p>
          <ul class="svc-list">
            <li data-i18n="svc2.b1">
              Upselling &amp; suggestive selling systems
            </li>
            <li data-i18n="svc2.b2">Waste control &amp; pour cost reduction</li>
            <li data-i18n="svc2.b3">
              Shift &amp; speed-of-service optimization
            </li>
          </ul>
        </article>

        <article class="svc-card">
          <div class="svc-num">03</div>
          <div class="svc-icon" aria-hidden="true">
            <svg
              width="26"
              height="26"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"></path><circle
                cx="9"
                cy="7"
                r="4"></circle><path d="M23 21v-2a4 4 0 00-3-3.87"></path><path
                d="M16 3.13a4 4 0 010 7.75"></path></svg
            >
          </div>
          <h3 class="svc-title" data-i18n="svc3.title">Staff Training</h3>
          <p class="svc-desc" data-i18n="svc3.desc">
            A bar is only as good as its team. I train bartenders and servers to
            work faster, communicate better, and deliver experiences that build
            loyal regulars.
          </p>
          <ul class="svc-list">
            <li data-i18n="svc3.b1">
              Bartending technique &amp; craft cocktails
            </li>
            <li data-i18n="svc3.b2">
              Guest experience &amp; hospitality standards
            </li>
            <li data-i18n="svc3.b3">
              Team coordination &amp; shift management
            </li>
          </ul>
        </article>

        <article class="svc-card">
          <div class="svc-num">04</div>
          <div class="svc-icon" aria-hidden="true">
            <svg
              width="26"
              height="26"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><rect x="2" y="3" width="20" height="14" rx="2" ry="2"
              ></rect><line x1="8" y1="21" x2="16" y2="21"></line><line
                x1="12"
                y1="17"
                x2="12"
                y2="21"></line></svg
            >
          </div>
          <h3 class="svc-title" data-i18n="svc4.title">Bar Operations</h3>
          <p class="svc-desc" data-i18n="svc4.desc">
            I assess how your bar operates behind the scenes and rebuild the
            systems that keep it running consistently, efficiently, and
            profitably — during every shift, not just the busy ones.
          </p>
          <ul class="svc-list">
            <li data-i18n="svc4.b1">Station setup &amp; workflow design</li>
            <li data-i18n="svc4.b2">Inventory management systems</li>
            <li data-i18n="svc4.b3">SOP creation &amp; documentation</li>
          </ul>
        </article>

        <article class="svc-card">
          <div class="svc-num">05</div>
          <div class="svc-icon" aria-hidden="true">
            <svg
              width="26"
              height="26"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><line x1="12" y1="1" x2="12" y2="23"></line><path
                d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"></path></svg
            >
          </div>
          <h3 class="svc-title" data-i18n="svc5.title">
            Bar Pricing &amp; Financial Strategy
          </h3>
          <p class="svc-desc" data-i18n="svc5.desc">
            Most bars are leaving money on the table without knowing it. I
            analyze your current pricing structure, identify gaps, and rebuild
            it so every drink reflects the quality you deliver and the profit
            you deserve.
          </p>
          <ul class="svc-list">
            <li data-i18n="svc5.b1">Pricing audit &amp; restructure</li>
            <li data-i18n="svc5.b2">Pour cost analysis</li>
            <li data-i18n="svc5.b3">Revenue tracking recommendations</li>
          </ul>
        </article>

        <article class="svc-card svc-card--cta">
          <p class="svc-cta-tag" data-i18n="svcCta.tag">
            Not sure where to start?
          </p>
          <h3 class="svc-cta-heading" data-i18n-html="svcCta.heading">
            Get a Free<br /><span class="gold-text">Bar Audit</span>
          </h3>
          <p class="svc-cta-body" data-i18n="svcCta.body">
            15 minutes on WhatsApp. I'll identify your top revenue leaks — no
            strings attached.
          </p>
          <a
            href={whatsappUrlEN}
            id="svcCtaLink"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-wa"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              ><path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
              ></path></svg
            >
            <span data-i18n="svcCta.btn">Start Free Audit</span>
          </a>
          <p class="svc-cta-email" data-i18n="svcCta.email">
            …or contact me at <a href="mailto:sebastian@thebarblueprint.net"
              >sebastian@thebarblueprint.net</a
            >
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- GALLERY -->
  <section
    id="gallery"
