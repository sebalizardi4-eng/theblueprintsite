  .btn-wa:hover {
    background: var(--c-wa-dk);
    box-shadow: 0 6px 28px rgba(37, 211, 102, 0.4);
  }
  .btn-ghost {
    background: transparent;
    color: var(--c-cream);
    border: 1.5px solid rgba(237, 229, 213, 0.25);
  }
  .btn-ghost:hover {
    border-color: var(--c-gold);
    color: var(--c-gold);
  }
  .btn-gold {
    background: var(--c-gold);
    color: var(--c-bg);
    font-weight: 700;
  }
  .btn-gold:hover {
    background: var(--c-gold-lt);
  }
  .btn-lg {
    padding: 1rem 2rem;
    font-size: 1rem;
  }
  .btn-xl {
    padding: 1.125rem 2.5rem;
    font-size: 1.125rem;
    border-radius: 4px;
  }

  /* ── NAVBAR ─────────────────────────────────── */
  #navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    padding: 0.875rem 0;
    transition:
      background 0.3s,
      box-shadow 0.3s;
  }
  #navbar.scrolled {
    background: rgba(6, 15, 24, 0.96);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 1px 0 var(--c-line);
  }
  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.75rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    position: relative;
  }
  .nav-logo img {
    height: 42px;
    width: auto;
    object-fit: contain;
  }
  .nav-links {
    display: flex;
    list-style: none;
    gap: 0;
    margin-left: auto;
    align-items: center;
  }
  .nav-link {
    display: block;
    padding: 0.5rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-cream-md);
    transition: color 0.2s;
    cursor: pointer;
  }
  .nav-link:hover {
    color: var(--c-gold);
  }

  /* language toggle */
  .lang-toggle {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    background: none;
    border: 1px solid rgba(201, 164, 82, 0.25);
    border-radius: 3px;
    padding: 0.3rem 0.6rem;
    cursor: pointer;
    transition: border-color 0.2s;
    flex-shrink: 0;
  }
  .lang-toggle:hover {
    border-color: rgba(201, 164, 82, 0.5);
  }
  .lang-opt {
    font-family: "Karla", sans-serif;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--c-muted);
    transition: color 0.2s;
    cursor: pointer;
  }
  .lang-opt.lang-active {
    color: var(--c-gold);
  }
  .lang-sep {
    font-size: 0.6rem;
    color: var(--c-muted);
    opacity: 0.4;
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1.125rem;
    background: var(--c-wa);
    color: #fff;
    border-radius: 3px;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    cursor: pointer;
    transition: background 0.2s;
    white-space: nowrap;
  }
  .nav-cta:hover {
    background: var(--c-wa-dk);
  }
  .nav-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--c-cream);
    cursor: pointer;
    padding: 0.5rem;
    margin-left: auto;
  }

  /* ── HERO ───────────────────────────────────── */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 8rem 1.75rem 5rem;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
  }
  .hero-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      rgba(6, 15, 24, 0.92) 0%,
      rgba(6, 15, 24, 0.78) 45%,
      rgba(6, 15, 24, 0.55) 70%,
      rgba(6, 15, 24, 0.4) 100%
    );
  }
  .hero-grid-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .crosshair {
    position: absolute;
    z-index: 2;
    width: 22px;
    height: 22px;
    pointer-events: none;
  }
  .crosshair::before,
  .crosshair::after {
    content: "";
    position: absolute;
    background: var(--c-gold);
    opacity: 0.3;
  }
  .crosshair::before {
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
  }
  .crosshair::after {
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
  }
  .crosshair-tl {
    top: 2.5rem;
    left: 2rem;
  }
  .crosshair-tr {
    top: 2.5rem;
    right: 2rem;
  }
  .crosshair-bl {
    bottom: 2.5rem;
    left: 2rem;
  }
  .crosshair-br {
    bottom: 2.5rem;
    right: 2rem;
  }

  .hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    position: relative;
    z-index: 3;
  }
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .hero-title {
    font-size: clamp(2.5rem, 5.5vw, 4rem);
    font-weight: 700;
    line-height: 1.08;
    color: var(--c-cream);
    letter-spacing: -0.01em;
  }
  .hero-subtitle {
    font-size: 1.125rem;
    color: var(--c-cream-md);
    line-height: 1.75;
    max-width: 490px;
  }
  .hero-ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .badge {
    display: inline-block;
    padding: 0.3125rem 0.875rem;
    border: 1px solid rgba(201, 164, 82, 0.3);
    border-radius: 100px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-gold);
    background: rgba(201, 164, 82, 0.06);
  }
  .hero-photo-panel {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .photo-frame {
    position: relative;
    border: 1px solid rgba(201, 164, 82, 0.3);
    padding: 1rem;
    background: rgba(6, 15, 24, 0.3);
  }
  .hero-photo {
    width: 100%;
    max-width: 520px;
    object-fit: cover;
    aspect-ratio: 4/3;
    filter: brightness(0.92) contrast(1.05) saturate(0.9);
  }
  .photo-frame-corners span {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--c-gold);
    border-style: solid;
    opacity: 0.65;
  }
  .photo-frame-corners span:nth-child(1) {
    top: 5px;
    left: 5px;
    border-width: 1px 0 0 1px;
  }
  .photo-frame-corners span:nth-child(2) {
    top: 5px;
    right: 5px;
    border-width: 1px 1px 0 0;
  }
  .photo-frame-corners span:nth-child(3) {
    bottom: 5px;
    left: 5px;
    border-width: 0 0 1px 1px;
  }
  .photo-frame-corners span:nth-child(4) {
    bottom: 5px;
    right: 5px;
    border-width: 0 1px 1px 0;
  }
  .photo-caption {
    position: absolute;
    bottom: -1.375rem;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: 0.5625rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--c-gold);
    opacity: 0.65;
    font-weight: 700;
  }
  .scroll-hint {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    animation: scrollPulse 2.5s ease-in-out infinite;
  }
  @keyframes scrollPulse {
    0%,
    100% {
      opacity: 0.35;
      transform: translateX(-50%) translateY(0);
    }
    50% {
      opacity: 0.7;
      transform: translateX(-50%) translateY(6px);
    }
  }

  /* ── PROOF STRIP ────────────────────────────── */
  .proof-strip {
    background: var(--c-bg-dark);
    border-top: 1px solid var(--c-line);
    border-bottom: 1px solid var(--c-line);
    padding: 1.125rem 1.75rem;
  }
  .proof-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
  }
  .proof-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-cream-md);
    white-space: nowrap;
  }
  .proof-item svg {
    color: var(--c-gold);
    flex-shrink: 0;
  }
  .proof-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--c-gold);
    opacity: 0.4;
  }

  /* ── SERVICES ───────────────────────────────── */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .svc-card {
    position: relative;
    padding: 2.25rem 2rem;
    background: var(--c-bg-card);
    border: 1px solid var(--c-line-dim);
    border-radius: 2px;
    transition:
      border-color 0.25s,
      transform 0.2s,
      box-shadow 0.25s;
    cursor: default;
  }
  .svc-card:hover {
    border-color: rgba(201, 164, 82, 0.35);
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
  }
  .svc-card--featured {
    border-color: rgba(201, 164, 82, 0.35);
    background: linear-gradient(
      160deg,
      rgba(201, 164, 82, 0.06) 0%,
      var(--c-bg-card) 60%
    );
  }
  .svc-pill {
    position: absolute;
    top: -0.625rem;
    left: 1.5rem;
    background: var(--c-gold);
    color: var(--c-bg);
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.25rem 0.625rem;
    border-radius: 2px;
  }
  .svc-card--cta {
    background: linear-gradient(
      140deg,
      rgba(201, 164, 82, 0.09) 0%,
      var(--c-bg-card) 70%
    );
    border-color: rgba(201, 164, 82, 0.3);
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    justify-content: center;
  }
  .svc-num {
    font-family: "Playfair Display SC", serif;
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    color: var(--c-gold);
    opacity: 0.45;
    margin-bottom: 0.75rem;
  }
  .svc-icon {
    width: 50px;
    height: 50px;
    border-radius: 2px;
    background: rgba(201, 164, 82, 0.08);
    border: 1px solid rgba(201, 164, 82, 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--c-gold);
    margin-bottom: 1rem;
  }
  .svc-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--c-cream);
    margin-bottom: 0.625rem;
  }
  .svc-desc {
    font-size: 0.9375rem;
    color: var(--c-cream-md);
    line-height: 1.7;
    margin-bottom: 1rem;
  }
  .svc-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .svc-list li {
    font-size: 0.875rem;
    color: var(--c-muted);
    padding-left: 1rem;
    position: relative;
  }
  .svc-list li::before {
    content: "–";
    position: absolute;
    left: 0;
    color: var(--c-gold);
    opacity: 0.6;
  }
  .svc-cta-tag {
    font-size: 0.75rem;
    color: var(--c-cream-md);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .svc-cta-heading {
    font-size: 1.5rem;
    color: var(--c-cream);
    line-height: 1.2;
  }
  .svc-cta-body {
    font-size: 0.9rem;
    color: var(--c-cream-md);
    line-height: 1.65;
  }
  .svc-cta-email {
    font-size: 0.8rem;
    color: var(--c-muted);
    line-height: 1.5;
    margin-top: 0.25rem;
  }
  .svc-cta-email a {
    color: var(--c-gold);
    text-decoration: none;
    transition: color 0.2s;
  }
  .svc-cta-email a:hover {
    color: var(--c-gold-lt);
  }

  /* ── GALLERY ────────────────────────────────── */
  .gallery-section {
    padding: 6rem 0;
    background: var(--c-bg-dark);
  }
  .gallery-header {
    text-align: center;
    margin-bottom: 3.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.125rem;
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: 480px;
    gap: 4px;
    max-width: 1400px;
    margin: 0 auto;
  }
  .gallery-item {
    position: relative;
    overflow: hidden;
    cursor: pointer;
  }
  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.6s,
      filter 0.4s;
    filter: brightness(0.8) saturate(0.85);
  }
  .gallery-item:hover img {
    transform: scale(1.04);
    filter: brightness(0.65) saturate(1);
  }
  .gallery-caption {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.75rem;
    background: linear-gradient(
      to top,
      rgba(6, 15, 24, 0.85) 0%,
      transparent 55%
    );
    opacity: 0;
    transition: opacity 0.35s;
  }
  .gallery-item:hover .gallery-caption {
    opacity: 1;
  }
  .gallery-caption-tag {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-gold);
    margin-bottom: 0.375rem;
  }
  .gallery-caption-text {
    font-size: 0.9375rem;
    color: var(--c-cream);
    font-weight: 500;
  }
  .gallery-item--wide {
    grid-column: 1;
  }

  /* ── ABOUT ──────────────────────────────────── */
  .about-section {
    position: relative;
    padding: 7rem 0;
    overflow: hidden;
  }
  .about-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .about-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.25) saturate(0.5);
  }
  .about-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(6, 15, 24, 0.95) 0%,
      rgba(6, 15, 24, 0.75) 60%,
      rgba(6, 15, 24, 0.9) 100%
    );
  }
  .about-layout {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6rem;
    align-items: center;
  }
  .about-photo-col {
    display: flex;
    justify-content: center;
  }
  .about-photo-frame {
    position: relative;
    border: 1px solid rgba(201, 164, 82, 0.3);
    padding: 1.25rem;
    max-width: 460px;
    width: 100%;
  }
  .about-photo {
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
    object-position: center top;
    filter: brightness(0.9) contrast(1.05) saturate(0.85);
  }
  .about-photo-corners span {
    position: absolute;
    width: 16px;
    height: 16px;
    border-color: var(--c-gold);
    border-style: solid;
    opacity: 0.6;
  }
  .about-photo-corners span:nth-child(1) {
    top: 7px;
    left: 7px;
    border-width: 2px 0 0 2px;
  }
  .about-photo-corners span:nth-child(2) {
    top: 7px;
    right: 7px;
    border-width: 2px 2px 0 0;
  }
  .about-photo-corners span:nth-child(3) {
    bottom: 7px;
    left: 7px;
    border-width: 0 0 2px 2px;
  }
  .about-photo-corners span:nth-child(4) {
    bottom: 7px;
    right: 7px;
    border-width: 0 2px 2px 0;
  }
  .about-creds-overlay {
    position: absolute;
    bottom: -0.875rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.5rem;
    white-space: nowrap;
  }
  .cred-item {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.625rem;
    background: var(--c-bg-dark);
    border: 1px solid rgba(201, 164, 82, 0.35);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--c-gold);
  }
  .about-content {
    display: flex;
    flex-direction: column;
    gap: 1.375rem;
  }
  .about-text {
    font-size: 1.0625rem;
    color: var(--c-cream-md);
    line-height: 1.8;
  }
  .about-highlights {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    margin-top: 0.375rem;
  }
  .highlight {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }
  .hl-icon {
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(201, 164, 82, 0.08);
    border: 1px solid rgba(201, 164, 82, 0.2);
    color: var(--c-gold);
    border-radius: 2px;
  }
  .highlight > div:last-child {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }
  .highlight strong {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--c-cream);
    display: block;
  }
  .highlight span {
    font-size: 0.875rem;
    color: var(--c-muted);
  }

  /* ── PROCESS ────────────────────────────────── */
  .process-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }
  .process-step {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--c-line-dim);
    padding: 2.5rem 2rem;
    position: relative;
    transition: background 0.25s;
  }
  .process-step:hover {
    background: rgba(201, 164, 82, 0.025);
  }
  .process-step:not(:last-child) {
    border-right: 1px solid var(--c-line-dim);
  }
  .step-num-wrap {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .step-num-circle {
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid rgba(201, 164, 82, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: "Playfair Display SC", serif;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--c-gold);
  }
  .step-connector-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, rgba(201, 164, 82, 0.3), transparent);
  }
  .step-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .step-icon {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: rgba(201, 164, 82, 0.08);
    border: 1px solid rgba(201, 164, 82, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--c-gold);
  }
  .step-title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--c-cream);
  }
  .step-desc {
    font-size: 0.9rem;
    color: var(--c-muted);
    line-height: 1.7;
  }

  /* ── FINAL CTA ──────────────────────────────── */
  .cta-section {
    position: relative;
    padding: 8rem 0;
    overflow: hidden;
  }
  .cta-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .cta-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.2) saturate(0.6);
  }
  .cta-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(6, 15, 24, 0.7),
      rgba(6, 15, 24, 0.85)
    );
  }
  .cta-grid {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .cta-inner {
    position: relative;
    z-index: 2;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.75rem;
  }
  .cta-title {
    font-size: clamp(2.25rem, 5.5vw, 3.5rem);
    font-weight: 700;
    color: var(--c-cream);
    line-height: 1.1;
  }
