---
---

<section id="gallery" class="gallery-section" aria-label="Bar portfolio gallery">
  <div class="gallery-header container">
    <p class="eyebrow" data-i18n="gal.eyebrow">Portfolio</p>
    <h2 class="section-title" data-i18n-html="gal.title">
      Spaces Transformed,<br /><span class="gold-text">Experiences Elevated</span>
    </h2>
  </div>
  <div class="gallery-grid">
    <figure class="gallery-item gallery-item--wide">
      <img
        src="/likesilkto-bar-4368709_1920.jpg"
        alt="Atmospheric bar interior with illuminated back-bar shelving"
        loading="lazy"
      />
      <figcaption class="gallery-caption">
        <span class="gallery-caption-tag" data-i18n="gal.tag1">Bar Design &amp; Operations</span>
        <span class="gallery-caption-text" data-i18n="gal.text1">Back-bar optimization &amp; atmosphere consulting</span>
      </figcaption>
    </figure>
    <figure class="gallery-item">
      <img
        src="/newhouse-bar-826688_1920.jpg"
        alt="Warm rustic restaurant and bar interior with brick walls"
        loading="lazy"
      />
      <figcaption class="gallery-caption">
        <span class="gallery-caption-tag" data-i18n="gal.tag2">Revenue Optimization</span>
        <span class="gallery-caption-text" data-i18n="gal.text2">Workflow &amp; layout redesign</span>
      </figcaption>
    </figure>
    <figure class="gallery-item">
      <img
        src="/tuanarch87-restaurant-6479814_1920.jpg"
        alt="Upscale modern restaurant bar with sleek stools and bottle display"
        loading="lazy"
      />
      <figcaption class="gallery-caption">
        <span class="gallery-caption-tag" data-i18n="gal.tag3">Menu Engineering</span>
        <span class="gallery-caption-text" data-i18n="gal.text3">Menu &amp; guest experience redesign</span>
      </figcaption>
    </figure>
  </div>
</section>
