  // WhatsApp links keyed by lang
  const WA = { en: whatsappUrlEN, es: whatsappUrlES };
  const WA_LINK_IDS = [
    "navCtaLink",
    "heroCta1",
    "svcCtaLink",
    "aboutCtaLink",
    "ctaMainLink",
    "footerWaLink",
    "floatWaLink",
  ];

  let currentLang = "en";

  function applyLang(lang) {
    const dict = T[lang];
    // plain text
    document.querySelectorAll("[data-i18n]").forEach((el) => {
      const key = el.getAttribute("data-i18n");
      if (dict[key] !== undefined) el.textContent = dict[key];
    });
    // html content
    document.querySelectorAll("[data-i18n-html]").forEach((el) => {
      const key = el.getAttribute("data-i18n-html");
      if (dict[key] !== undefined) el.innerHTML = dict[key];
    });
    // update all WhatsApp links
    WA_LINK_IDS.forEach((id) => {
      const el = document.getElementById(id);
      if (el) el.href = WA[lang];
    });
    // toggle active indicator
    document
      .getElementById("langEN")
      ?.classList.toggle("lang-active", lang === "en");
    document
      .getElementById("langES")
      ?.classList.toggle("lang-active", lang === "es");
    // update html lang attribute
    document.documentElement.lang = lang === "es" ? "es" : "en";
  }

  document.getElementById("langToggle")?.addEventListener("click", () => {
    currentLang = currentLang === "en" ? "es" : "en";
    applyLang(currentLang);
  });

  // navbar scroll + mobile menu
  const toggle = document.getElementById("navToggle");
  const links = document.getElementById("navLinks");
  const navbar = document.getElementById("navbar");

  toggle?.addEventListener("click", () => {
    const open = links?.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", String(open));
  });
  document.querySelectorAll(".nav-link").forEach((l) =>
    l.addEventListener("click", () => {
      links?.classList.remove("is-open");
      toggle?.setAttribute("aria-expanded", "false");
    }),
  );
  window.addEventListener(
    "scroll",
    () => {
      navbar?.classList.toggle("scrolled", window.scrollY > 60);
    },
    { passive: true },
  );
</script>

